{
  "_nota": "App 'Suporte Rápido' (clientes): só entrada, portátil, aprovação por clique, sem password permanente (Fase 3). Chaves validadas contra RustDesk 1.5.3; conn-type/disable-* são HARD_SETTINGS (topo).",
  "app-name": "AdvirDesk Suporte",
  "conn-type": "incoming",
  "disable-installation": "Y",
  "disable-settings": "Y",
  "override-settings": {
    "custom-rendezvous-server": "<RENDEZVOUS_SERVER>",
    "relay-server": "<RENDEZVOUS_SERVER>",
    "api-server": "<API_SERVER>",
    "key": "<RS_PUB_KEY>",
    "approve-mode": "click",
    "verification-method": "use-temporary-password",
    "allow-auto-update": "N",
    "enable-check-update": "N",
    "enable-terminal": "N",
    "enable-remote-printer": "N",
    "enable-audio": "N",
    "enable-file-transfer": "Y",
    "enable-remote-restart": "N",
    "allow-remote-config-modification": "N",
    "enable-lan-discovery": "N",
    "direct-server": "N"
  }
}
